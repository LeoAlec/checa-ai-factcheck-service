# Necessaria para embeddings OpenAI e para gerar a resposta da verificacao.
OPENAI_API_KEY=

# Devem corresponder ao provedor, modelo e colecao usados na indexacao.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_COLLECTION=fact_checks_pt_v2_openai
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_db

# Recuperação (relevância, não probabilidade de veracidade)
SIMILARITY_THRESHOLD=0.60
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH=3
MAX_DOCUMENTS=3
MAX_CONTEXT_CHARS=4000

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
TAVILY_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ─── Langfuse (LLMOps) ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_CAPTURE_CONTENT=false
PROMPT_LABEL=production

# Smoke E2E real
RUN_E2E=
E2E_ALLOW_REFERENCE_LOCAL_INDEX=0

# Obrigatória para moderação, embeddings OpenAI e síntese
OPENAI_API_KEY=

# Obrigatória apenas para o fallback web
TAVILY_API_KEY=

# Embeddings: openai | local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant HTTP recomendado. Vazio usa o índice local em QDRANT_PATH.
# Nunca aponte --recreate/ingest para o índice de referência.
QDRANT_URL=http://localhost:6333
QDRANT_PATH=data/qdrant_db
QDRANT_COLLECTION=fact_checks_pt_v2_openai

# Recuperação (relevância, não probabilidade de veracidade)
SIMILARITY_THRESHOLD=0.60
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH=3
MAX_DOCUMENTS=3
MAX_CONTEXT_CHARS=4000

# LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Observabilidade opcional
LANGFUSE_ENABLED=false
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
PROMPT_LABEL=production

# Smoke E2E real. RUN_E2E pode ser definido no shell ou aqui.
RUN_E2E=
# Só use 1 ao consultar diretamente o índice embarcado de referência.
E2E_ALLOW_REFERENCE_LOCAL_INDEX=0

# Avaliação offline de classificadores (não usada por /api/debunk)
# Aponte para arquivos externos; não copie pesos ou dados curados para o Git.
CLASSIFIER_TFIDF_MODEL_PATH=
CLASSIFIER_TFIDF_METRICS_PATH=
CLASSIFIER_TFIDF_PREDICTIONS_PATH=
CLASSIFIER_BERTIMBAU_MODEL_PATH=
CLASSIFIER_BERTIMBAU_METRICS_PATH=
CLASSIFIER_BERTIMBAU_PREDICTIONS_PATH=
CLASSIFIER_EXTERNAL_DATASET_PATH=
CLASSIFIER_EVALUATION_OUTPUT_DIR=reports/classifier-evaluation
CLASSIFIER_BERTIMBAU_DEVICE=cpu
CLASSIFIER_BERTIMBAU_BATCH_SIZE=16
CLASSIFIER_DECISION_THRESHOLD=0.5

# --- Retrieval avancado / NER / NLI (todos opcionais) ---
HYBRID_ENABLED=true
HYBRID_LEXICAL_WEIGHT=1.2
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=15
NER_BACKEND=auto
NER_SPACY_MODEL=pt_core_news_lg
NLI_ENABLED=false
NLI_ABSTAIN_ON_DISAGREEMENT=false

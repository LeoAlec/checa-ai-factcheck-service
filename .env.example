# Necessaria para embeddings OpenAI e para gerar a resposta da verificacao.
OPENAI_API_KEY=

# Devem corresponder ao provedor, modelo e colecao usados na indexacao.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
QDRANT_COLLECTION=fact_checks_pt_v2_openai

# Mude para true ao usar EMBEDDING_PROVIDER=local e reconstruir a imagem.
INSTALL_LOCAL_EMBEDDINGS=false

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
TAVILY_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────────
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2

# ─── Langfuse (LLMOps) ───────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_CAPTURE_CONTENT=true
PROMPT_LABEL=production

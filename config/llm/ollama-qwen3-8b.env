# Perfil local: a API em Docker alcança o Ollama executado no host.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://host.docker.internal:11434/v1/
LLM_API_KEY=ollama
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=120
# O avaliador roda diretamente no host, portanto usa localhost.
EVAL_LLM_BASE_URL=http://localhost:11434/v1/
